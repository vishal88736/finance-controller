# AI Finance Controller - Environment Configuration
# Razorpay AI Buildathon — Track 4

# Primary LLM Provider: Groq (llama-3.3-70b-versatile)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# LangSmith Tracing & Observability (Optional: Set to trace runs in LangSmith dashboard)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-finance-controller
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Razorpay Integration (Optional: Future ingestion source)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./finance_controller.db
